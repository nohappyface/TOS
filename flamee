<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Flame — Legal</title>
<style>
  :root{
    --bg:#0f1115;
    --panel:#161922;
    --text:#e7e9ee;
    --muted:#9aa1ad;
    --accent:#5aa9e6;
    --border:#252a35;
  }
  *{box-sizing:border-box;}
  body{
    margin:0;
    background:var(--bg);
    color:var(--text);
    font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;
    line-height:1.6;
  }
  header{
    padding:48px 24px 24px;
    text-align:center;
    border-bottom:1px solid var(--border);
  }
  header h1{
    margin:0 0 8px;
    font-size:2rem;
    letter-spacing:-0.02em;
  }
  header h1 span{color:var(--accent);}
  header p{color:var(--muted);margin:0;}
  nav{
    display:flex;
    justify-content:center;
    gap:16px;
    padding:20px;
    flex-wrap:wrap;
  }
  nav a{
    color:var(--text);
    text-decoration:none;
    padding:8px 18px;
    border:1px solid var(--border);
    border-radius:999px;
    font-size:0.9rem;
  }
  nav a:hover{border-color:var(--accent);color:var(--accent);}
  main{
    max-width:760px;
    margin:0 auto;
    padding:24px 24px 80px;
  }
  section{
    background:var(--panel);
    border:1px solid var(--border);
    border-radius:14px;
    padding:32px 36px;
    margin-bottom:32px;
  }
  section h2{
    margin-top:0;
    font-size:1.5rem;
    border-bottom:1px solid var(--border);
    padding-bottom:12px;
  }
  section h3{
    color:var(--accent);
    font-size:1.05rem;
    margin-top:28px;
  }
  section p, section li{
    color:#c7cbd4;
    font-size:0.97rem;
  }
  .updated{
    color:var(--muted);
    font-size:0.85rem;
    margin-bottom:24px;
  }
  footer{
    text-align:center;
    color:var(--muted);
    font-size:0.85rem;
    padding:24px;
    border-top:1px solid var(--border);
  }
</style>
</head>
<body>

